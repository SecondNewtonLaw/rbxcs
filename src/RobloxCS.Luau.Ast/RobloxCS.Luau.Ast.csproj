<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure Luau AST node types (no writer, no Roslyn). Segmented from RobloxCS.Luau so the
       node model is a standalone, dependency-free layer. Namespace stays RobloxCS.Luau. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RobloxCS.Luau</RootNamespace>
  </PropertyGroup>

</Project>
