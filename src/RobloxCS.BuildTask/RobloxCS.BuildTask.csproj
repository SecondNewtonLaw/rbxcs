<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Task assembly + its deps get copied into the SDK package's tasks/ folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Build-only PrivateAssets dep (MSBuild host provides it at runtime); advisory N/A here. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the MSBuild host; do not ship. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.8" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="..\RobloxCS.Transpiler\RobloxCS.Transpiler.csproj" />
  </ItemGroup>

</Project>
