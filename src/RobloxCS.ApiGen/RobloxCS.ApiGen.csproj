<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-build-time tool (decision #7): parses the Roblox API Dump JSON and emits C# ref
       declarations (namespace Roblox). Not shipped; its output is compiled into the API ref assembly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
